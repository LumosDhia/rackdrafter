{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/node",
    "tsBuildInfoFile": "./dist/node.tsbuildinfo",
    "types": ["node"],
    "noEmit": true,
    "composite": false
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "eslint.config.js",
    "scripts/**/*.ts"
  ]
}
