{
  "name": "rackdrafter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit --pretty",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:fetch": "tsx scripts/icons/build-glyphs.ts && tsx scripts/icons/fetch-icons.ts",
    "api": "tsx src/server/dev-server.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/middie": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@xyflow/react": "^12.8.6",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^5.0.3",
    "idb-keyval": "^6.2.2",
    "immer": "^10.1.3",
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tabler/icons": "^3.35.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "simple-icons": "^16.37.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.4.1"
  }
}
